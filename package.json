{
  "name": "hearthos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:quality": "tsx --test tests/quality/*.test.ts",
    "test:customer-persistence": "node scripts/testing/quality-customer-center.mjs && node scripts/testing/quality-customer-creation.mjs",
    "test:payment-persistence": "node scripts/testing/quality-payment-recording.mjs && node scripts/testing/quality-square-capture.mjs && node scripts/testing/quality-payment-import.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@clerk/nextjs": "^6.39.6",
    "canvas": "^3.2.2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.21.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "pdfkit": "^0.18.0",
    "postgres": "^3.4.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
